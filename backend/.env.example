# ─── APPLICATION ───────────────────────────────────────────
APP_NAME=RAGBot System
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=cambia_esto_por_una_clave_muy_segura_de_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── DATABASE ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ragbot_user:password@localhost:5432/ragbot_db
DATABASE_URL_SYNC=postgresql://ragbot_user:password@localhost:5432/ragbot_db

# ─── REDIS (cache de sesiones y rate limiting) ─────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI PROVIDERS ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OLLAMA_BASE_URL=http://localhost:11434

# ─── EMBEDDINGS ────────────────────────────────────────────
# Opciones: openai | sentence_transformers | google
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── RAG SETTINGS ──────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
MAX_CONTEXT_TOKENS=4000

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://tudominio.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ─── FILE STORAGE ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── RATE LIMITING ─────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# true SOLO si corrés detrás del nginx de docker-compose.yml u otro proxy de confianza
# (lee X-Forwarded-For/X-Real-IP para identificar al cliente real). Si no hay proxy real
# por delante, dejalo en false: cualquiera podría falsificar ese header y evadir el límite.
TRUST_PROXY_HEADERS=false

# ─── LOGGING ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/ragbot.log

# ─── ALERTAS DE FALLO DEL BOT (opcional) ───────────────────
# Si el chat falla con un error interno se avisa por mail y/o webhook.
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=600
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
